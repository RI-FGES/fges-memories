# Copie ce fichier en ".env" et remplis les valeurs.
# Ne jamais mettre de clé SECRÈTE ici : tout ce qui commence par VITE_ est visible dans le navigateur.

# --- Firebase (Console Firebase > Paramètres du projet > Vos applications) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary (uniquement des valeurs publiques) ---
VITE_CLOUDINARY_CLOUD_NAME=dorl1r9wq
# Preset d'upload NON signé, à restreindre dans Cloudinary (dossier, formats, taille max)
VITE_CLOUDINARY_UPLOAD_PRESET=ml_default

# --- Domaines email autorisés à se connecter (séparés par des virgules) ---
# À faire correspondre avec la fonction emailUniversitaire() de firestore.rules
VITE_DOMAINES_AUTORISES=univ-catholille.fr,lacatholille.fr
